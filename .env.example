# Copia este archivo a "assets/env" y rellena los valores.
# (Se usa assets/env, sin punto inicial: un archivo .env NO se empaqueta en el
#  build web release de Flutter y la app queda en pantalla blanca.)
# SOLO valores PUBLICOS. NUNCA pongas aqui el service_role key.
#
# La app compila SIEMPRE contra PRODUCCION. No hay un ambiente de desarrollo
# propio para el portal de agentes, igual que en la app de clientes: lo que se
# prueba en localhost es lo que ve el agente, y toda escritura de prueba cae en
# datos reales. Los mismos valores estan en el workflow de deploy web.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# (OPCIONAL) Ids de rol que entran al portal, separados por coma. Por defecto
# estan fijos en codigo: 3 (Agente Inmobiliario) y 9 (Agente Interno), que son
# los de produccion (ver features/auth/services/portal_access.dart). Solo se
# setea aqui para probar un ambiente donde esos ids sean distintos.
AGENTE_ROL_IDS=
